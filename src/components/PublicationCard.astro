---
const { item } = Astro.props;
const tag = item.data.tags?.[0] ?? item.data.venue;
const href = `/publications/${item.id}/`;
const searchText = [
  item.data.title,
  item.data.description,
  item.data.venue,
  ...item.data.tags,
  ...(item.data.authors ?? [])
].join(' ').toLowerCase();
const filterText = [item.data.venue, ...item.data.tags].join('|').toLowerCase();
---
<a class="card" href={href} data-publication-card data-search={searchText} data-filters={filterText}>
  <span class="card-media">
    <img class="card-image" src={item.data.image} alt="" loading="lazy" />
    <span class="tag-pill">{tag}</span>
  </span>
  <span class="card-body">
    <h3>{item.data.title}</h3>
    <p>{item.data.description}</p>
    <span class="card-foot">
      <span class="card-meta">{item.data.venue}</span>
      <span class="card-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12h13M12.5 6.5 18 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </span>
  </span>
</a>
