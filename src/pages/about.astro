---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitorMapSummary from '../components/visualization/VisitorMapSummary.vue';
import VisitorWorldMap from '../components/visualization/VisitorWorldMap.vue';
import aboutStats from '../data/about-stats.json';

const sortByDate = <T extends { data: { pubDate: Date } }>(items: T[]) =>
  items.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const publications = sortByDate(
  (await getCollection('publications')).filter((item) => !item.data.draft)
);
const collectionItems = sortByDate(
  (await getCollection('collections')).filter((item) => !item.data.draft)
);
const workshopItems = sortByDate(
  (await getCollection('workshops')).filter((item) => !item.data.draft)
);
const blogItems = sortByDate(
  (await getCollection('blogs')).filter((item) => !item.data.draft)
);

const formatYear = (date: Date) => String(date.getFullYear());
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(date);
const publicationKind = (venue: string) => {
  if (/preprint|arxiv/i.test(venue)) return 'preprint';
  if (/journal|transactions|tpami|ijcv/i.test(venue)) return 'journal';
  return 'conference';
};

const formatNumber = (value: number | null | undefined) =>
  typeof value === 'number' ? new Intl.NumberFormat('en-US').format(value) : 'Updating';

const githubStars = formatNumber(aboutStats.github?.stars);
const googleScholarCitations =
  aboutStats.googleScholar?.display?.trim() || formatNumber(aboutStats.googleScholar?.citations);
const semanticScholarCitations =
  aboutStats.semanticScholar?.display?.trim() || formatNumber(aboutStats.semanticScholar?.citations);
const huggingFaceMonthlyDownloads = formatNumber(
  aboutStats.huggingface?.monthlyDownloads ?? aboutStats.huggingface?.downloads
);
const modelScopeDownloads = formatNumber(
  aboutStats.modelscope?.totalDownloads ?? aboutStats.modelscope?.downloads
);
const xiaohongshuLikes =
  aboutStats.xiaohongshu?.display ?? formatNumber(aboutStats.xiaohongshu?.likesAndCollects);

const personStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://choucisan.github.io/about/#person',
  name: 'Zhishan Zou',
  alternateName: ['邹志山', 'choucisan'],
  url: 'https://choucisan.github.io/about/',
  image: 'https://choucisan.github.io/assets/about/zhishan-zou.jpeg',
  email: 'mailto:choucisan@gmail.com',
  description: 'Zhishan Zou is a student at Beijing University of Posts and Telecommunications researching video understanding and generation, behavior and cognition, and agentic intelligence.',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Beijing University of Posts and Telecommunications',
    url: 'https://www.bupt.edu.cn/'
  },
  knowsAbout: [
    'Artificial intelligence',
    'Video understanding',
    'Video generation',
    'Behavior and cognition',
    'Agentic intelligence'
  ],
  sameAs: [
    'https://orcid.org/0009-0000-9029-912X',
    'https://scholar.google.com/citations?user=MLkojp4AAAAJ&hl=en',
    'https://www.semanticscholar.org/author/Zhishan-Zou/2449782969',
    'https://www.alphaxiv.org/@zhishan-zou',
    'https://openalex.org/authors/A5144700690',
    'https://github.com/choucisan',
    'https://huggingface.co/choucsan',
    'https://www.modelscope.cn/profile/choucisan',
    'https://www.xiaohongshu.com/user/profile/624aab39000000001000d3bc'
  ]
};
---
<BaseLayout
  title="Zhishan Zou | OneThree"
  description="Zhishan Zou is a student at Beijing University of Posts and Telecommunications researching video understanding and generation, behavior and cognition, and agentic intelligence."
  image="/assets/about/zhishan-zou.jpeg"
  author="Zhishan Zou"
  ogType="profile"
  structuredData={personStructuredData}
  bodyClass="about-body"
  showFooterIllustration={false}
>
  <main class="about-page" data-about-page>
    <section class="about-story">
      <div class="container about-story-grid">
        <p class="about-label">My story</p>
        <div class="about-copy">
          <h1>
            <em>A simple belief:</em>
            <span>They will not labor in vain, nor will they bear children doomed to misfortune; for they will be a people blessed by the Lord, they and their descendants with them.</span>
          </h1>
        </div>
      </div>
      <div class="about-clouds" aria-hidden="true">
        <img class="about-cloud about-cloud-left" src="/assets/hero/cloud-large.png" alt="" />
        <img class="about-cloud about-cloud-right" src="/assets/hero/cloud-large.png" alt="" />
      </div>
    </section>
    <section class="about-profile" data-about-portfolio>
      <div class="container about-profile-inner">
        <h2 class="about-label about-profile-title">About Me</h2>
        <div class="about-profile-grid">
          <aside class="about-profile-sidebar">
            <figure class="about-portrait-frame">
              <div class="about-portrait-mat">
                <img src="/assets/about/zhishan-zou.jpeg" alt="Portrait of Zhishan Zou" loading="lazy" />
              </div>
            </figure>
            <nav class="about-profile-links" aria-label="Profile links">
              <a href="/" aria-label="Homepage" title="Homepage">
                <img src="/assets/icons/icon-3d.png" alt="" aria-hidden="true" />
              </a>
              <a href="mailto:choucisan@gmail.com" aria-label="Email choucisan@gmail.com" title="choucisan@gmail.com">
                <img src="/assets/icons/gmail.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://orcid.org/0009-0000-9029-912X" target="_blank" rel="noreferrer" aria-label="ORCID" title="ORCID">
                <img src="/assets/icons/orcid.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://scholar.google.com/citations?user=MLkojp4AAAAJ&amp;hl=en" target="_blank" rel="noreferrer" aria-label="Google Scholar" title="Google Scholar">
                <img src="/assets/icons/google-scholar.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://www.semanticscholar.org/author/Zhishan-Zou/2449782969" target="_blank" rel="noreferrer" aria-label="Semantic Scholar" title="Semantic Scholar">
                <img src="/assets/icons/semantic-scholar.png" alt="" aria-hidden="true" />
              </a>
              <a href="https://www.alphaxiv.org/@zhishan-zou" target="_blank" rel="noreferrer" aria-label="alphaXiv" title="alphaXiv">
                <img class="about-profile-link-alphaxiv" src="/assets/icons/alphaxiv.png" alt="" aria-hidden="true" />
              </a>
              <a href="https://openalex.org/authors/A5144700690" target="_blank" rel="noreferrer" aria-label="OpenAlex" title="OpenAlex">
                <img class="about-profile-link-openalex" src="/assets/icons/openalex.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://github.com/choucisan" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
                <img src="/assets/icons/github.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://huggingface.co/choucsan" target="_blank" rel="noreferrer" aria-label="Hugging Face" title="Hugging Face">
                <img src="/assets/icons/huggingface.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://www.modelscope.cn/profile/choucisan" target="_blank" rel="noreferrer" aria-label="ModelScope" title="ModelScope">
                <img class="about-profile-link-modelscope" src="/assets/icons/modelscope.png" alt="" aria-hidden="true" />
              </a>
              <a href="https://www.xiaohongshu.com/user/profile/624aab39000000001000d3bc" target="_blank" rel="noreferrer" aria-label="Xiaohongshu" title="Xiaohongshu">
                <img src="/assets/icons/xiaohongshu.svg" alt="" aria-hidden="true" />
              </a>
              <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
                <img src="/assets/icons/linkedin.svg" alt="" aria-hidden="true" />
              </a>
            </nav>
          </aside>

          <div class="about-profile-main">
            <div class="about-profile-intro">
              <p>
                Hi there! 👋 I'm Zhishan Zou (邹志山), a student at Beijing University of Posts and Telecommunications. My research explores artificial intelligence, with a particular focus on video understanding and generation, behavior and cognition, and agentic intelligence. You can find my publications on <a href="https://scholar.google.com/citations?user=MLkojp4AAAAJ&amp;hl=en" target="_blank" rel="noreferrer">Google Scholar</a>. I'm always open to research collaborations and conversations around brave new ideas.
              </p>
            </div>

            <div class="about-portfolio-explorer">
              <div class="about-portfolio-tabs" role="tablist" aria-label="Portfolio sections">
                <button class="is-active" id="about-tab-publications" type="button" role="tab" aria-selected="true" aria-controls="about-panel-publications" data-about-tab="publications">Publications</button>
                <button id="about-tab-collections" type="button" role="tab" aria-selected="false" aria-controls="about-panel-collections" data-about-tab="collections">Collections</button>
                <button id="about-tab-workshops" type="button" role="tab" aria-selected="false" aria-controls="about-panel-workshops" data-about-tab="workshops">Workshops</button>
                <button id="about-tab-blogs" type="button" role="tab" aria-selected="false" aria-controls="about-panel-blogs" data-about-tab="blogs">Blogs</button>
              </div>

              <section class="about-portfolio-panel is-active" id="about-panel-publications" role="tabpanel" aria-labelledby="about-tab-publications" data-about-panel="publications">
                <div class="about-publication-filters" aria-label="Publication type filters">
                  <button class="is-active" type="button" data-about-publication-filter="all">All</button>
                  <button type="button" data-about-publication-filter="conference">Conference</button>
                  <button type="button" data-about-publication-filter="journal">Journal</button>
                  <button type="button" data-about-publication-filter="preprint">Preprints</button>
                </div>
                <div class="about-portfolio-list" data-about-panel-list>
                  {publications.map((item) => (
                    <article class="about-portfolio-card about-publication-card" data-about-publication-card={publicationKind(item.data.venue)}>
                      <a class="about-portfolio-media" href={`/publications/${item.id}/`} aria-label={`Open ${item.data.title}`}>
                        <img src={item.data.image} alt="" loading="lazy" />
                        <span>{item.data.venue}</span>
                      </a>
                      <div class="about-portfolio-card-body">
                        <h4><a href={`/publications/${item.id}/`}>{item.data.title}</a></h4>
                        {item.data.authors.length > 0 && <p class="about-publication-authors">{item.data.authors.join(', ')}</p>}
                        <p class="about-publication-venue"><em>{item.data.venue}</em><span>{formatYear(item.data.pubDate)}</span></p>
                        <div class="about-portfolio-actions">
                          {item.data.paperUrl && <a href={item.data.paperUrl} target="_blank" rel="noreferrer">arXiv</a>}
                          {item.data.codeUrl && <a href={item.data.codeUrl} target="_blank" rel="noreferrer">GitHub</a>}
                          {item.data.huggingfaceUrl && <a href={item.data.huggingfaceUrl} target="_blank" rel="noreferrer">Hugging Face</a>}
                          {item.data.modelscopeUrl && <a href={item.data.modelscopeUrl} target="_blank" rel="noreferrer">ModelScope</a>}
                          <a href={`/publications/${item.id}/`}>Project Page</a>
                        </div>
                      </div>
                    </article>
                  ))}
                  <p class="about-portfolio-empty" data-about-publication-empty hidden>No publications in this category yet.</p>
                </div>
              </section>

              <section class="about-portfolio-panel" id="about-panel-collections" role="tabpanel" aria-labelledby="about-tab-collections" data-about-panel="collections" hidden>
                <div class="about-portfolio-list" data-about-panel-list>
                  {collectionItems.map((item) => (
                    <article class="about-portfolio-card">
                      <a class="about-portfolio-media" href={`/collections/${item.id}/`} aria-label={`Open ${item.data.title}`}>
                        <img src={item.data.image} alt="" loading="lazy" />
                        <span>{item.data.platform}</span>
                      </a>
                      <div class="about-portfolio-card-body">
                        <h4><a href={`/collections/${item.id}/`}>{item.data.title}</a></h4>
                        <p class="about-portfolio-description">{item.data.description}</p>
                        <p class="about-portfolio-meta"><span>{item.data.platform}</span><span>{formatDate(item.data.pubDate)}</span></p>
                        <div class="about-portfolio-actions">
                          <a href={`/collections/${item.id}/`}>View Project</a>
                          {item.data.githubUrl && <a href={item.data.githubUrl} target="_blank" rel="noreferrer">GitHub</a>}
                          {item.data.huggingfaceUrl && <a href={item.data.huggingfaceUrl} target="_blank" rel="noreferrer">Hugging Face</a>}
                          {item.data.exampleUrl && <a href={item.data.exampleUrl} target="_blank" rel="noreferrer">Live Example</a>}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>

              <section class="about-portfolio-panel" id="about-panel-workshops" role="tabpanel" aria-labelledby="about-tab-workshops" data-about-panel="workshops" hidden>
                <div class="about-portfolio-list" data-about-panel-list>
                  {workshopItems.map((item) => (
                    <article class="about-portfolio-card">
                      <a class="about-portfolio-media" href={`/workshops/${item.id}/`} aria-label={`Open ${item.data.title}`}>
                        <img src={item.data.image} alt="" loading="lazy" />
                        <span>{item.data.platform}</span>
                      </a>
                      <div class="about-portfolio-card-body">
                        <h4><a href={`/workshops/${item.id}/`}>{item.data.title}</a></h4>
                        <p class="about-portfolio-description">{item.data.description}</p>
                        <p class="about-portfolio-meta"><span>{item.data.platform}</span><span>{formatDate(item.data.pubDate)}</span></p>
                        <div class="about-portfolio-actions">
                          <a href={`/workshops/${item.id}/`}>Open Workshop</a>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>

              <section class="about-portfolio-panel" id="about-panel-blogs" role="tabpanel" aria-labelledby="about-tab-blogs" data-about-panel="blogs" hidden>
                <div class="about-portfolio-list" data-about-panel-list>
                  {blogItems.map((item) => (
                    <article class="about-portfolio-card">
                      <a class="about-portfolio-media" href={`/blogs/${item.id}/`} aria-label={`Read ${item.data.title}`}>
                        <img src={item.data.image} alt="" loading="lazy" />
                        <span>{item.data.category}</span>
                      </a>
                      <div class="about-portfolio-card-body">
                        <h4><a href={`/blogs/${item.id}/`}>{item.data.title}</a></h4>
                        <p class="about-portfolio-description">{item.data.description}</p>
                        <p class="about-portfolio-meta"><span>{item.data.category}</span><span>{formatDate(item.data.pubDate)}</span></p>
                        <div class="about-portfolio-actions">
                          <a href={`/blogs/${item.id}/`}>Read Article</a>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="pink-cloud-transition about-pink-cloud-transition" data-reveal-scene aria-hidden="true">
      <img class="pink-cloud pink-cloud-left" src="/assets/scene/pink-cloud.png" alt="" loading="lazy" />
      <img class="pink-cloud pink-cloud-right" src="/assets/scene/pink-cloud.png" alt="" loading="lazy" />
      <img class="pink-cloud-bird pink-cloud-bird-large" src="/assets/hero/goose-main.png" alt="" loading="lazy" />
      <img class="pink-cloud-bird pink-cloud-bird-small" src="/assets/hero/goose-left.png" alt="" loading="lazy" />
    </section>
    <section class="about-contact">
      <div class="container about-contact-grid">
        <p class="about-label">Contact Me</p>
        <div class="contact-links" aria-label="Contact links">
          <a class="contact-card" href="mailto:choucisan@gmail.com" aria-label="Email choucisan@gmail.com" title="choucisan@gmail.com">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-gmail" src="/assets/icons/gmail.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">Email</span>
              <span class="contact-stat">choucisan@gmail.com</span>
            </span>
          </a>
          <a class="contact-card" href="https://orcid.org/0009-0000-9029-912X" target="_blank" rel="noreferrer" aria-label="ORCID" title="ORCID">
            <span class="contact-icon-wrap">
              <img class="contact-icon" src="/assets/icons/orcid.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">ORCID</span>
              <span class="contact-stat">0009-0000-9029-912X</span>
            </span>
          </a>
          <a class="contact-card" href="https://scholar.google.com/citations?user=MLkojp4AAAAJ&amp;hl=en" target="_blank" rel="noreferrer" aria-label="Google Scholar" title="Google Scholar">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-scholar" src="/assets/icons/google-scholar.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">Google Scholar</span>
              <span class="contact-stat">{googleScholarCitations} total citations</span>
            </span>
          </a>
          <a class="contact-card" href="https://www.semanticscholar.org/author/Zhishan-Zou/2449782969" target="_blank" rel="noreferrer" aria-label="Semantic Scholar" title="Semantic Scholar">
            <span class="contact-icon-wrap">
              <img class="contact-icon" src="/assets/icons/semantic-scholar.png" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">Semantic Scholar</span>
              <span class="contact-stat">{semanticScholarCitations} total citations</span>
            </span>
          </a>
          <a class="contact-card" href="https://www.alphaxiv.org/@zhishan-zou" target="_blank" rel="noreferrer" aria-label="alphaXiv" title="alphaXiv">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-alphaxiv" src="/assets/icons/alphaxiv.png" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">alphaXiv</span>
              <span class="contact-stat">Research profile</span>
            </span>
          </a>
          <a class="contact-card" href="https://openalex.org/authors/A5144700690" target="_blank" rel="noreferrer" aria-label="OpenAlex" title="OpenAlex">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-openalex" src="/assets/icons/openalex.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">OpenAlex</span>
              <span class="contact-stat">Author profile</span>
            </span>
          </a>
          <a class="contact-card" href="https://github.com/choucisan" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-github" src="/assets/icons/github.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">GitHub</span>
              <span class="contact-stat">{githubStars} total stars</span>
            </span>
          </a>
          <a class="contact-card" href="https://huggingface.co/choucsan" target="_blank" rel="noreferrer" aria-label="Hugging Face" title="Hugging Face">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-hf" src="/assets/icons/huggingface.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">Hugging Face</span>
              <span class="contact-stat">{huggingFaceMonthlyDownloads} monthly downloads</span>
            </span>
          </a>
          <a class="contact-card" href="https://www.modelscope.cn/profile/choucisan" target="_blank" rel="noreferrer" aria-label="ModelScope" title="ModelScope">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-modelscope" src="/assets/icons/modelscope.png" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">ModelScope</span>
              <span class="contact-stat">{modelScopeDownloads} total downloads</span>
            </span>
          </a>
          <a class="contact-card" href="https://www.xiaohongshu.com/user/profile/624aab39000000001000d3bc" target="_blank" rel="noreferrer" aria-label="Xiaohongshu" title="Xiaohongshu">
            <span class="contact-icon-wrap">
              <img class="contact-icon contact-icon-xhs" src="/assets/icons/xiaohongshu.svg" alt="" loading="lazy" />
            </span>
            <span class="contact-copy">
              <span class="contact-name">Xiaohongshu</span>
              <span class="contact-stat">{xiaohongshuLikes} likes & collects</span>
            </span>
          </a>
        </div>
      </div>
    </section>
    <section class="garden-transition about-garden-transition" data-reveal-scene aria-hidden="true">
      <img class="transition-branch transition-branch-left" src="/assets/scene/branch-left.png" alt="" loading="lazy" />
      <img class="transition-branch transition-branch-right" src="/assets/scene/branch-right.png" alt="" loading="lazy" />
      <img class="transition-dove transition-dove-large" src="/assets/scene/dove-large.png" alt="" loading="lazy" />
      <img class="transition-dove transition-dove-small" src="/assets/scene/dove-small.png" alt="" loading="lazy" />
    </section>
    <section class="about-visitor-map" data-reveal-scene data-visitor-map>
      <div class="container about-visitor-map-inner">
        <div class="about-visitor-map-head">
          <p class="about-visitor-map-label">Visitors Map</p>
          <VisitorMapSummary client:load />
        </div>
        <div class="about-visitor-map-frame">
          <VisitorWorldMap client:load />
        </div>
      </div>
    </section>
    <section class="about-footer-garden" data-reveal-scene aria-hidden="true">
      <img class="about-bottom-logo" src="/assets/logo/title-large.png" alt="" loading="lazy" />
      <img class="about-footer-flower" src="/assets/footer/footer.png" alt="" loading="lazy" />
    </section>
  </main>
  <script>
    const aboutPage = document.querySelector('[data-about-page]');
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const updateAboutClouds = () => {
      if (!aboutPage) return;

      const progress = clamp(window.scrollY / Math.min(window.innerHeight * 1.1, 900), 0, 1);
      aboutPage.style.setProperty('--about-cloud-left-x', `${-progress * Math.min(window.innerWidth * 0.16, 230)}px`);
      aboutPage.style.setProperty('--about-cloud-left-y', `${-progress * Math.min(window.innerHeight * 0.1, 115)}px`);
      aboutPage.style.setProperty('--about-cloud-right-x', `${progress * Math.min(window.innerWidth * 0.07, 105)}px`);
      aboutPage.style.setProperty('--about-cloud-right-y', `${-progress * Math.min(window.innerHeight * 0.045, 54)}px`);
    };

    updateAboutClouds();
    window.addEventListener('scroll', updateAboutClouds, { passive: true });
    window.addEventListener('resize', updateAboutClouds);

    const aboutPortfolio = document.querySelector('[data-about-portfolio]');
    const aboutTabs = Array.from(aboutPortfolio?.querySelectorAll('[data-about-tab]') ?? []);
    const aboutPanels = Array.from(aboutPortfolio?.querySelectorAll('[data-about-panel]') ?? []);
    const publicationFilters = Array.from(aboutPortfolio?.querySelectorAll('[data-about-publication-filter]') ?? []);
    const publicationCards = Array.from(aboutPortfolio?.querySelectorAll('[data-about-publication-card]') ?? []);
    const publicationEmpty = aboutPortfolio?.querySelector('[data-about-publication-empty]');

    aboutTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selected = tab.dataset.aboutTab;
        aboutTabs.forEach((item) => {
          const isActive = item === tab;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-selected', String(isActive));
        });
        aboutPanels.forEach((panel) => {
          const isActive = panel.dataset.aboutPanel === selected;
          panel.classList.toggle('is-active', isActive);
          panel.toggleAttribute('hidden', !isActive);
          if (isActive) panel.querySelector('[data-about-panel-list]')?.scrollTo({ top: 0 });
        });
      });
    });

    publicationFilters.forEach((filter) => {
      filter.addEventListener('click', () => {
        const selected = filter.dataset.aboutPublicationFilter ?? 'all';
        let visibleCount = 0;
        publicationFilters.forEach((item) => item.classList.toggle('is-active', item === filter));
        publicationCards.forEach((card) => {
          const isVisible = selected === 'all' || card.dataset.aboutPublicationCard === selected;
          card.toggleAttribute('hidden', !isVisible);
          if (isVisible) visibleCount += 1;
        });
        if (publicationEmpty) publicationEmpty.toggleAttribute('hidden', visibleCount !== 0);
      });
    });
  </script>
</BaseLayout>
